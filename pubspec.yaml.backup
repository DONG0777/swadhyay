name: swadhyay_app
description: A Flutter quiz and social-learning platform
publish_to: 'none'
version: 1.0.0+1

environment:
  sdk: ^3.5.0

dependencies:
  flutter:
    sdk: flutter

  # Supabase & APIs
  supabase_flutter: ^2.0.0
  http: ^1.1.0

  # Local Storage
  shared_preferences: ^2.0.15

  # Sharing & URL
  url_launcher: ^6.1.11

  # GPS Location
  geolocator: ^13.0.1
  permission_handler: ^12.0.1

  # YouTube Player for Surya Namaskar
  youtube_player_flutter: ^9.1.1

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^4.0.0

flutter:
  uses-material-design: true

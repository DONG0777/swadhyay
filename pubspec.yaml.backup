name: swadhyay_app
description: A Flutter quiz and social-learning platform
publish_to: 'none'
version: 1.0.0+1

environment:
  sdk: ^3.5.0

dependencies:
  flutter:
    sdk: flutter
  supabase_flutter: ^2.0.0
  shared_preferences: ^2.0.15
  url_launcher: ^6.1.11
  http: ^1.1.0
  geolocator: ^13.0.1
  permission_handler: ^12.0.1

  flutter_localizations:
    sdk: flutter
  intl: any
dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^4.0.0

  flutter_localizations:
    sdk: flutter
  intl: any
  flutter_gen_runner: ^5.4.0
  intl_utils: ^2.8.7
flutter:
  uses-material-design: true
  generate: true


